# ==========================================
# .gitignore para Voluntario+ (raíz del proyecto)
# ==========================================

# Dependencias de Node.js (back y front)
node_modules/
frontend/node_modules/
backend/node_modules/

# Variables de entorno con credenciales sensibles
.env
backend/.env
frontend/.env
*.env
*.env.*
!.env.example

# Archivos de logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2-*.log

# Archivos generados por el editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Builds y archivos compilados
dist/
build/
frontend/dist/
frontend/build/
backend/certificados/   # certificados PDF generados en tiempo de ejecución
*.pdf

# Archivos temporales y de caché
.cache/
.parcel-cache/
*.tmp
*.temp

# Archivos de cobertura de pruebas
coverage/
.nyc_output/

# Archivos de configuración local
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos de respaldo
*.bak
*.old
*.orig
